# Local deterministic defaults. Keep secrets in an untracked .env file.
APP_ENVIRONMENT=development
MCP_TRANSPORT=memory
RESULT_OUTPUT_DIR=outputs
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# Optional model and tracing configuration. The deterministic MVP does not
# require either setting for its automated tests or representative run.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=multi-agent-financial-analysis
