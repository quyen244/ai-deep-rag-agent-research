{
  "name": "financial-analysis-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse": "lighthouse http://127.0.0.1:3000 --only-categories=performance,accessibility,best-practices --output=json --output-path=reports/lighthouse.json",
    "preflight": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-tabs": "1.1.21",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "15.5.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "3.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "axe-core": "4.11.0",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.9",
    "jsdom": "27.1.0",
    "lighthouse": "13.4.1",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
